<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>CP_Lead_Approval_Decision_To_Owner</fullName>
        <description>Tells the Channel Partner user who submitted the lead whether the Direct Sales Manager and the JKP CP Manager approved or rejected it.</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderAddress>isha.raj@utilitarianlabs.com</senderAddress>
        <senderType>OrgWideEmailAddress</senderType>
        <template>unfiled$public/CP_Lead_Approval_Decision</template>
    </alerts>
    <fieldUpdates>
        <fullName>CP_Lead_Set_Approved</fullName>
        <field>CP_Approval_Status__c</field>
        <literalValue>Approved</literalValue>
        <name>CP Lead Set Approved</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>CP_Lead_Set_Assigned</fullName>
        <field>Status</field>
        <literalValue>Assigned</literalValue>
        <name>CP Lead Set Assigned</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>CP_Lead_Set_Rejected</fullName>
        <field>CP_Approval_Status__c</field>
        <literalValue>Rejected</literalValue>
        <name>CP Lead Set Rejected</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
</Workflow>
