<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Phone</field>
        <field>Email</field>
        <field>Project__c</field>
        <field>Channel_Partner__c</field>
        <field>Existing_Direct_Lead__c</field>
        <field>CP_Approval_Status__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Direct_Sales_Approver__c</name>
                <type>relatedUserField</type>
            </approver>
            <approver>
                <name>CP_Approver__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>Unanimous</whenMultipleApprovers>
        </assignedApprover>
        <description>Both the Direct Sales Manager (the existing lead owner&apos;s manager) and the JKP CP Manager (the channel partner account owner&apos;s manager) must approve.</description>
        <label>Direct Sales and CP Manager</label>
        <name>Direct_Sales_and_CP_Manager</name>
    </approvalStep>
    <description>A Channel Partner submitted a customer that Direct Sales or a referral already has for the project. The Channel Partner&apos;s lead waits as Pending approval; if both managers approve it moves to Assigned, otherwise it stays Rejected and the Channel Partner user is emailed.</description>
    <emailTemplate>unfiled$public/CP_Lead_Approval_Request</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Lead.CP_Approval_Status__c</field>
            <operation>equals</operation>
            <value>Pending</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>CP_Lead_Approval_Decision_To_Owner</name>
            <type>Alert</type>
        </action>
        <action>
            <name>CP_Lead_Set_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>CP_Lead_Set_Assigned</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>CP_Lead_Approval_Decision_To_Owner</name>
            <type>Alert</type>
        </action>
        <action>
            <name>CP_Lead_Set_Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>CP Lead Approval</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
