# Minimal .forceignore for generic CI/CD pipeline
# Only ignore what truly cannot be deployed

package.xml

# LWC configuration files
**/jsconfig.json
**/.eslintrc.json

# LWC Jest tests
**/__tests__/**

node_modules/

# ==========================================
# Org-Specific Metadata (Cannot be deployed)
# ==========================================

# Salesforce Internal/Managed Permission Sets
**/permissionsets/sfdcInternalInt__*
**/permissionsets/force__*

# SAML and Security (org-specific)
**/samlssoconfigs/**

# System metadata
**/appMenus/**
**/installedPackages/**

# ==========================================
# Experience Cloud
# ==========================================
# These components hard-reference a Network (Community). Network metadata
# cannot be retrieved by the CLI ("You do not have the proper permissions to
# access Network"), so it can never live in the repo. Without it, every
# Network-dependent component fails to deploy. They are still tracked in
# source control -- only excluded from the deployment payload.
**/sites/**
**/navigationMenus/**
**/digitalExperienceConfigs/**
**/digitalExperiences/**
