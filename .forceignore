# Minimal .forceignore for generic CI/CD pipeline
# Only ignore what truly cannot be deployed

package.xml

# LWC configuration files
**/jsconfig.json
**/.eslintrc.json

# LWC Jest tests
**/__tests__/**

node_modules/

# ==========================================
# Org-Specific Metadata (Cannot be deployed)
# ==========================================

# Salesforce Internal/Managed Permission Sets
**/permissionsets/sfdcInternalInt__*
**/permissionsets/force__*

# SAML and Security (org-specific)
**/samlssoconfigs/**

# System metadata
**/appMenus/**
**/installedPackages/**

# ==========================================
# Experience Cloud
# ==========================================
# Inaccessible Network infrastructure metadata:
# The deployment user does not have administrative permissions to retrieve or deploy Network
# records. Therefore, infrastructure metadata types that directly create or reference the Network
# boundary (CustomSite, NavigationMenu, DigitalExperienceConfig, Audience, NetworkBranding)
# are excluded from deployment. The target sandbox already has the Experience Cloud site created.
#
# Experience Cloud Site Content (ALLOWED):
# **/digitalExperiences/** (DigitalExperienceBundle & DigitalExperience) IS PRESERVED and deployed.
# It updates site views, pages, routes, and CMS content on the existing target-org site.
# **/sites/**
# **/navigationMenus/**
# **/digitalExperienceConfigs/**
# **/audience/**
**/networkBranding/**

# Secrets: contains an OAuth client secret, must never be deployed from source
**/customMetadata/OneDriveAuthSetting.*.md-meta.xml